{
  "name": "marketplace-contract-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "check:env": "node scripts/check-env-example.mjs",
    "lint:api": "redocly lint openapi/openapi.yaml",
    "bundle:api": "redocly bundle openapi/openapi.yaml -o spec.json",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "js-yaml": "4.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.0",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
