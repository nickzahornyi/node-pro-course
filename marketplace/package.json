{
  "name": "marketplace-contract-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "build:watch": "tsc --watch -p tsconfig.json",
    "check:env": "node scripts/check-env-example.mjs",
    "migrate": "bash scripts/with-secrets.sh dev typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev typeorm migration:revert -d dist/data-source.js",
    "migration:generate": "bash scripts/with-secrets.sh dev node dist/generate-migration.js",
    "check:indexes": "bash scripts/with-secrets.sh dev node dist/check-indexes.js",
    "api:up": "sh scripts/api-up.sh",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "test:concurrency": "bash scripts/with-secrets.sh dev node --test integration/concurrency.test.js",
    "test:ops": "bash scripts/with-secrets.sh dev node --test integration/ops.test.js",
    "test:integration": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/integration",
    "test:e2e": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/e2e",
    "test:realtime": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/e2e/realtime",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "test:contract": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/contract",
    "verify:provider": "npm run build && node test/contract/verify-provider.js",
    "pact:publish": "node scripts/pact-broker.mjs publish",
    "pact:tag-prod": "node scripts/pact-broker.mjs tag-prod",
    "pact:can-i-deploy": "node scripts/pact-broker.mjs can-i-deploy",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "lint:api": "redocly lint openapi/openapi.yaml",
    "bundle:api": "redocly bundle openapi/openapi.yaml -o spec.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/websockets": "11.1.6",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "js-yaml": "4.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "typeorm": "0.3.28",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@pact-foundation/pact": "17.1.4",
    "@redocly/cli": "2.46.0",
    "@testcontainers/postgresql": "11.7.2",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "ajv": "8.17.1",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
