# Runtime mode: development, test, or production.
NODE_ENV=development
# HTTP port exposed by the Marketplace API.
PORT=3000
# PostgreSQL URL without a password; the password is read from DB_PASSWORD_FILE.
DB_URL=postgresql://marketplace@localhost:6432/marketplace
# Path to the mounted PostgreSQL password secret.
DB_PASSWORD_FILE=secrets/db_password
# Maximum number of PostgreSQL connections in the pool.
DB_POOL_MAX=10
# Optional ORM password injected by Infisical or CI; omit to use the file secret.
DB_PASSWORD=marketplace-local-password
# At least two distinct collection sizes for the N+1 comparison.
NPLUS1_SIZES=5,10
# Signing key file for realtime identities; Compose creates a random key once.
AUTH_SECRET_FILE=secrets/realtime_auth_secret
# Optional env override for local/test use; generate your own key for production.
AUTH_SECRET=local-example-only-replace-with-random-secret
